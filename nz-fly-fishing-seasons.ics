BEGIN:VEVENT
UID:nz-backcountry-season@nz-fly-fishing-seasons
DTSTAMP:20260519T000000Z
SEQUENCE:0
DTSTART;VALUE=DATE:20261101
DTEND;VALUE=DATE:20270601
RRULE:FREQ=YEARLY;BYMONTH=11;BYMONTHDAY=1
SUMMARY:Backcountry & designated waters season
DESCRIPTION:Many designated backcountry and headwater rivers open later\, a
 round 1 November\; some southern rivers run to 31 May. Dates vary - check 
 the regional Anglers Notice.
CATEGORIES:Fly Fishing,New Zealand,Backcountry
TRANSP:TRANSPARENT
END:VEVENT
